# Server
# Plain HTTP, comma separated.
SERVER_ADDR=0.0.0.0:80
# HTTPS once a certificate is set; 7886 is where existing clients connect. Restart after renewing.
# TLS_ADDR=0.0.0.0:443,0.0.0.0:7886
# TLS_CERT_FILE=fullchain.pem
# TLS_KEY_FILE=privkey.pem
# Proxies allowed to set the client address: CIDRs, or `cloudflare` for its ranges.
# With cloudflared, list the address cloudflared connects from.
# TRUSTED_PROXIES=127.0.0.1/32,::1/128,cloudflare
# REAL_IP_HEADER=CF-Connecting-IP

# MySQL or MariaDB; the schema is created and extended on startup.
DATABASE_URL=mysql://axochat:password@localhost:3306/axochat

# compose.yaml: image to run instead of building, the data directory, and a Cloudflare tunnel
# routed to http://localhost:80.
# AXOCHAT_IMAGE=
# DATA_DIR=./data
# COMPOSE_PROFILES=tunnel
# TUNNEL_TOKEN=

# Messages
MESSAGE_MAX_LENGTH=100
MESSAGE_MAX_MESSAGES=40
MESSAGE_COUNT_DURATION=1m
# Service API roles that may use color codes and emoji; staff always may.
PERK_ROLES=premium

# LiquidBounce Service API: checks account logins. The token is needed for roles (staff)
# and for Minecraft accounts linked to an account.
API_URL=https://api.liquidbounce.net
# API_TOKEN=

# A staff login for tooling: LoginAccount with this token logs in as the staff account SERVICE_NAME.
# Unset disables it.
# SERVICE_TOKEN=
# SERVICE_NAME=LiquidChat

# Moderation: how long a user's last address is kept for IP bans.
IP_RETENTION=30d

# Filters for global messages of users who are not staff: `none`, or any of
# - rustrict: censors slurs before delivery; staff also get the original text.
# - moderation: the OpenAI moderation endpoint, free; removes a message after delivery when a
#   category scores at least its threshold. The defaults only catch outright hate: plain slurs
#   score like everyday banter ("ur gay", "retarded").
# - llm: an OpenAI-compatible Chat Completions API answering REMOVE or KEEP; removes after delivery.
MESSAGE_FILTERS=none
# RUSTRICT_CENSOR=offensive:severe
# OPENAI_API_KEY=
# MODERATION_MODEL=omni-moderation-latest
# MODERATION_THRESHOLDS=hate=0.88,hate/threatening=0.5
# LLM_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=
# A file with the system prompt; src/filter.prompt.md without.
# LLM_PROMPT=

# JWT login, disabled without JWT_SECRET. Leave unused variables unset, not empty.
# JWT_SECRET=
# JWT_ALGORITHM=HS256
# JWT_VALID_TIME=30d

# Logging
RUST_LOG=info
