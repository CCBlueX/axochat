# Server
# Plain HTTP, comma separated.
SERVER_ADDR=0.0.0.0:80
# HTTPS once a certificate is set; 7886 is where v1 clients connect. Restart after renewing.
# TLS_ADDR=0.0.0.0:443,0.0.0.0:7886
# TLS_CERT_FILE=fullchain.pem
# TLS_KEY_FILE=privkey.pem
# Proxies allowed to set the client address: CIDRs, or `cloudflare` for its ranges.
# With cloudflared, list the address cloudflared connects from.
# TRUSTED_PROXIES=127.0.0.1/32,::1/128,cloudflare
# REAL_IP_HEADER=CF-Connecting-IP

# MySQL or MariaDB; the schema is created and extended on startup. compose.yaml sets it from DB_PASSWORD.
DATABASE_URL=mysql://axochat:password@localhost:3306/axochat
DB_PASSWORD=

# compose.yaml: route a Cloudflare tunnel to http://localhost:80.
# COMPOSE_PROFILES=tunnel
# TUNNEL_TOKEN=

# Messages
MESSAGE_MAX_LENGTH=100
MESSAGE_MAX_MESSAGES=40
MESSAGE_COUNT_DURATION=1m
# Service API roles allowed to use color codes and emoji, highlighted in chat. Staff always are.
PERK_ROLES=premium

# LiquidBounce Account login. Staff are the users with a staff role in the Service API.
# API_URL=https://api.liquidbounce.net
# API_TOKEN=

# Staff login for tooling: a LoginAccount with this token logs in as the staff account SERVICE_NAME.
# Unset disables it.
# SERVICE_TOKEN=
# SERVICE_NAME=LiquidChat

# How long a user's last address is kept for IP bans.
IP_RETENTION=30d

# Logging
RUST_LOG=info
